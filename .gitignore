# Release output (generated by scripts/build-release.ps1)
release/

# Internal notes / review / discussion — NEVER public.
# Convention: only README and CHANGELOG live at the repo root. Every other
# root-level .md is internal by default (review findings, comparative
# assessments, submission prep, cross-repo incident notes, roadmap/discussion
# exchanges) and is auto-excluded, so a note dropped at the root can't leak.
# Public documentation goes under docs/ instead.
/*.md
!/README.md
!/CHANGELOG.md
docs/internal/

# Submission prep + internal coordination docs (regenerable / private ecosystem)
mcp-manifest.json
docs/DOWNSTREAM_CONTRACTS.md
